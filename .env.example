# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public by design (they ship inside the app); the database is
# protected by row-level security. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
