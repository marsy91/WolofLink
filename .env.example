# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public by design (they ship inside the app); the database is
# protected by row-level security. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# In-app purchases (RevenueCat public SDK keys; they ship inside the app).
# Leave empty until RevenueCat and the store products are set up.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
# RevenueCat Test Store: debug builds only (release builds crash on purpose with a test key).
NEXT_PUBLIC_REVENUECAT_TEST_KEY=
NEXT_PUBLIC_REVENUECAT_TEST_STORE=off

# Optional Supporter subscription (everything stays free; badge + unlimited drops).
NEXT_PUBLIC_SUPPORTER=off

# Push on iPhone (needs the Firebase iOS setup first: docs/store/ios-review.md).
NEXT_PUBLIC_PUSH_IOS=off
# App Review login: this one account signs in with a fixed 8-digit password typed in the code
# box (no email is sent). Empty = off. Create the account in Supabase first (docs/store/ios-review.md).
NEXT_PUBLIC_REVIEW_EMAIL=
