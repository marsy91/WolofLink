<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up lesson progress, but never the sign-in session, which is
     encrypted with a keystore key that does not leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cap_sec.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cap_sec.xml" />
    </device-transfer>
</data-extraction-rules>
