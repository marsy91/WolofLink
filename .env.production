# Public Supabase settings for release builds (baked into the app at build time).
# Both values are designed to be public; data is protected by row-level security.
# NEVER add the service-role / secret key here or anywhere in this repo.
NEXT_PUBLIC_SUPABASE_URL=https://gedwqsxwcjiuatmszxkg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_22OJfX5eYW4TyI_IcViyxQ_3jgNHLkc

# Launch switches (src/lib/features.ts; README, "Launch configuration").
# Paid Premium. off = every unit is free and no purchase screens are shown.
# Set to "on" once RevenueCat and the store products are set up.
NEXT_PUBLIC_PREMIUM=off
# Optional accounts, cloud sync, team codes and the owner console. The Supabase
# sign-in emails show the 6-digit code ({{ .Token }}). Set to off to hide them.
NEXT_PUBLIC_ACCOUNTS=on
# Circle demo ranking with sample learners: keep off for store builds.
NEXT_PUBLIC_CIRCLE=off
# Friend push notifications (Firebase). Needs android/app/google-services.json.
NEXT_PUBLIC_PUSH=on
# Optional Supporter subscription: every lesson stays free; supporters get a badge and
# unlimited drops. Turn on ONLY after the Play subscriptions and RevenueCat are set up
# (docs/sales/supporter-setup.md) and the public RevenueCat SDK key below is filled in.
NEXT_PUBLIC_SUPPORTER=off
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Browser tests only (a fake store in place of Google Play). Keep off in every store build.
NEXT_PUBLIC_FAKE_BILLING=off
